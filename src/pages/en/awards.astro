---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getEntry } from 'astro:content';

const awardsContent = await getEntry('awards-en', 'index');
if (!awardsContent) {
  throw new Error('Awards content not found');
}
const { Content } = await awardsContent.render();
---

<Layout title="AWARDS" lang="en">
  <PageHero titleEn="AWARDS" subtitle="Awards" image="images/sub_awards@2x.jpg" />

  <section class="content-section">
    <div class="container">
      <div class="markdown-content">
        <Content />
      </div>
    </div>
  </section>
</Layout>

<style>
  .content-section {
    padding: 80px 0;
  }

  .markdown-content {
    color: var(--text-dark);
    line-height: 1.8;
  }
</style>
