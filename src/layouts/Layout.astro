---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	lang?: 'ja' | 'en';
	alternateHref?: string;
}

const {
	title,
	description = '塩田・貴家研究室 - 東京都立大学 システムデザイン学部',
	lang = 'ja',
	alternateHref,
} = Astro.props;

const pageTitle = `塩田・貴家研究室 | ${title}`;
const ogImage = new URL('ogp.webp', Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={lang}>
	<head>
		<base href={import.meta.env.BASE_URL} />
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="675" />
		<meta property="og:image:alt" content="塩田・貴家研究室" />
		<meta property="og:site_name" content="塩田・貴家研究室" />
		<meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/png" href="favicon.webp" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Libertinus+Serif+Display:opsz,wght@45..45,400&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<Header lang={lang} alternateHref={alternateHref} />
		<main>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
